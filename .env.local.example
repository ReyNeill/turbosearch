# Optional. Without this, TurboSearch uses deterministic local hash embeddings.
OPENAI_API_KEY=
TURBOSEARCH_EMBEDDING_PROVIDER=hash
TURBOSEARCH_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage: SQLite is the plug-and-play local default. Postgres is for shared/prod corpora.
TURBOSEARCH_STORAGE=sqlite
TURBOSEARCH_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
TURBOSEARCH_POSTGRES_PSQL_BM25S=true

# PDF parsing: LiteParse first, pdftotext fallback, GLM-OCR for scanned/sparse pages.
TURBOSEARCH_PDF_PARSER=liteparse
TURBOSEARCH_PDF_OCR_MAX_PAGES=200

# OCR: Ollama for local development, vLLM target for production.
TURBOSEARCH_OCR_PROVIDER=ollama-glm-ocr
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GLM_OCR_MODEL=glm-ocr:latest
VLLM_GLM_OCR_BASE_URL=http://127.0.0.1:8000/v1
VLLM_GLM_OCR_API_KEY=
VLLM_GLM_OCR_MODEL=zai-org/GLM-OCR
TURBOSEARCH_OCR_MODE=text
TURBOSEARCH_OCR_PROMPT=
TURBOSEARCH_OCR_CONTEXT_TOKENS=8192
TURBOSEARCH_OCR_MAX_OUTPUT_TOKENS=2048

# Video visual OCR: sample frames on a fixed interval and send them through GLM-OCR.
TURBOSEARCH_VIDEO_FRAME_OCR=true
TURBOSEARCH_VIDEO_FRAME_OCR_INTERVAL_SECONDS=30
TURBOSEARCH_VIDEO_FRAME_OCR_MAX_FRAMES=60

# Transcription: Cohere API for testing, vLLM endpoint for private/prod.
TURBOSEARCH_TRANSCRIPTION_PROVIDER=cohere-api
COHERE_API_KEY=
COHERE_TRANSCRIBE_ENDPOINT=http://127.0.0.1:8000/v1/audio/transcriptions
COHERE_TRANSCRIBE_MODEL=cohere-transcribe-03-2026
COHERE_TRANSCRIBE_LANGUAGE=en
