# Optional. Without this, TurboSearch uses deterministic local hash embeddings.
OPENAI_API_KEY=
TURBOSEARCH_EMBEDDING_PROVIDER=hash
TURBOSEARCH_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OCR: Ollama for local development, vLLM target for production.
TURBOSEARCH_OCR_PROVIDER=ollama-glm-ocr
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GLM_OCR_MODEL=glm-ocr:latest
TURBOSEARCH_OCR_MODE=text
TURBOSEARCH_OCR_PROMPT=
TURBOSEARCH_OCR_CONTEXT_TOKENS=8192
TURBOSEARCH_OCR_MAX_OUTPUT_TOKENS=2048

# Transcription: Cohere API for testing, vLLM endpoint for private/prod.
TURBOSEARCH_TRANSCRIPTION_PROVIDER=cohere-api
COHERE_API_KEY=
COHERE_TRANSCRIBE_ENDPOINT=http://127.0.0.1:8000/v1/audio/transcriptions
COHERE_TRANSCRIBE_MODEL=cohere-transcribe-03-2026
COHERE_TRANSCRIBE_LANGUAGE=en
