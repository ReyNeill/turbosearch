# Optional. Without this, TurboSearch uses deterministic local hash embeddings.
OPENAI_API_KEY=
TURBOSEARCH_EMBEDDING_PROVIDER=hash
TURBOSEARCH_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OCR: Ollama for local development, vLLM target for production.
TURBOSEARCH_OCR_PROVIDER=ollama-glm-ocr
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GLM_OCR_MODEL=glm-ocr:latest
TURBOSEARCH_OCR_PROMPT=Text Recognition:
